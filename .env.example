# 可选。不填也能把六屏走完：口气用本地孙悟空模板。
# 填写后只改写说法，不改教学动作，也不补新的解题步骤。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选。不填则使用内置识别桩，返回题库里的示例文字。
# 接口需接受 POST JSON，并返回 { "text": "识别出的题目" }。
OCR_API_URL=
OCR_API_KEY=

# SQLite 文件位置，相对项目根目录。删掉这个文件即可重置学情和练习。
DATABASE_PATH=data/tutor.db
